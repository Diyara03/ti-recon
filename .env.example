# TI Recon — example environment file.
# Variable NAMES only. Never commit real credential values.
# Copy to `.env` (git-ignored) for local development.
#
# NOTE: In TI Recon the runtime source of provider credentials is the
# per-user credential store (src/ti_recon/credentials), NOT process
# environment variables. These entries exist only for local development
# bootstrapping of future provider adapters.

# --- Provider credentials (per-user in production) ---
# Google Threat Intelligence authenticates with a VirusTotal API key; there is
# deliberately no separate GTI key.
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
GREYNOISE_API_KEY=
# Censys Platform API v3 authenticates with a personal access token. The older
# API ID / secret pair belongs to Search API v2, which is not implemented.
CENSYS_PAT=

# One abuse.ch Auth-Key serves ThreatFox, URLhaus and MalwareBazaar: they share
# the `abuse_ch` credential group, so an analyst stores it once.
ABUSECH_AUTH_KEY=

# Hybrid Analysis / Falcon Sandbox. API v2 authenticates with this single
# header value; there is deliberately no api-secret. A free restricted,
# self-signed key is enough for every Task 12 path (~5 requests/minute,
# ~200/hour) — passive report lookup needs no elevated access.
HYBRID_ANALYSIS_API_KEY=

# --- Google Threat Intelligence ---
# Identifies this integration to Google on every request. Not a secret.
# Recommended shape: organization.product.major.minor
GTI_X_TOOL=

# --- Censys ---
# Non-secret, per-connection: it selects the organization credit endpoint instead
# of the user one. In production it lives in ProviderConnection.metadata, not
# here; this entry exists for the optional live tests.
CENSYS_ORGANIZATION_ID=

# --- Optional live provider tests (off by default) ---
# Each provider needs its own RUN_*_LIVE_TESTS=1 plus its credential. Without
# them, tests/live skips and nothing contacts a real API.
RUN_GTI_LIVE_TESTS=
VT_APIKEY=
RUN_URLSCAN_LIVE_TESTS=
RUN_GREYNOISE_LIVE_TESTS=
RUN_CENSYS_LIVE_TESTS=
RUN_ABUSECH_LIVE_TESTS=
RUN_HYBRID_ANALYSIS_LIVE_TESTS=

# --- Runtime ---
TI_RECON_LOG_LEVEL=
