#!/bin/sh
# The TI Recon MCP launcher the plugin's .mcp.json starts.
#
# It runs the local stdio server and nothing else. Provider credentials arrive
# in this process's environment, placed there by Claude Code from the plugin's
# configuration; they are read once by the server and never written anywhere by
# this script. stdout belongs to the MCP protocol, so nothing here prints to it.
#
# THIS BUILD OF THE PLUGIN BUNDLES NO RUNTIME. Runtime packaging is a later
# phase; until then the launcher fails closed with the message below. A bundled
# runtime, when one exists, is expected at runtime/bin/ti-recon-mcp under the
# plugin root — the one location this script will run — and there is no other
# way to point it at an executable: no environment override, no search of PATH,
# no development mode. A developer proof is a separately generated, clearly
# marked copy of this plugin (tools/build_dev_plugin.py), never this file.
set -u

root="${CLAUDE_PLUGIN_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
runtime="$root/runtime/bin/ti-recon-mcp"

if [ -x "$runtime" ]; then
  exec "$runtime" "$@"
fi

printf '%s\n' \
  "ti-recon plugin: this build bundles no TI Recon runtime, so the MCP server cannot start." \
  "Runtime packaging is not complete in this version of the plugin. See docs/claude-plugin.md." \
  >&2
exit 1
